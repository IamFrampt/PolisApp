@using Newtonsoft.Json
@using PolisApp.Models

@inject IHttpClientFactory HttpClientFactory

<MudPaper Class="pa-4">

    <MudGrid Spacing="3">

        <!-- CITIES -->
        <MudItem xs="12" md="6">

            <MudSelect T="string"
                       Label="Städer"
                       MultiSelection="true"
                       Clearable="true"
                       Variant="Variant.Outlined"
                       SelectedValues="selectedCities"
                       SelectedValuesChanged="OnCitiesChanged">

                @foreach (var city in SwedishCities.OrderBy(x => x))
                {
                    <MudSelectItem T="string" Value="@city">
                        @city
                    </MudSelectItem>
                }

            </MudSelect>

        </MudItem>

        <!-- CRIME TYPES -->
        <MudItem xs="12" md="6">

            <MudSelect T="string"
                       Label="Typ av brott"
                       MultiSelection="true"
                       Clearable="true"
                       Variant="Variant.Outlined"
                       SelectedValues="selectedCrimeTypes"
                       SelectedValuesChanged="OnCrimeTypesChanged">

                @foreach (var crimeType in CrimeTypes.OrderBy(x => x))
                {
                    <MudSelectItem T="string" Value="@crimeType">
                        @crimeType
                    </MudSelectItem>
                }

            </MudSelect>

        </MudItem>

        <MudItem xs="12" Class="d-flex flex-wrap gap-2">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_isLoading"
                       OnClick="GetCrimesAsync">

                @if (_isLoading)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                    <span>Hämtar brott...</span>
                }
                else
                {
                    <span>Sök efter brott</span>
                }

            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Disabled="@(!_hasSelectedFilters || _isLoading)"
                       OnClick="ClearSelections">

                Rensa val

            </MudButton>

        </MudItem>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Error" Dense="true">
                    @errorMessage
                </MudAlert>
            </MudItem>
        }

    </MudGrid>

</MudPaper>

@code {

    [Parameter]
    public EventCallback<List<CrimeDTO>> CrimeListChanged { get; set; }

    private HashSet<string> selectedCities = new();
    private HashSet<string> selectedCrimeTypes = new();

    private async Task OnCitiesChanged(IReadOnlyCollection<string> values)
    {
        selectedCities = values.ToHashSet();
        await FilterCrimesAsync();
    }

    private async Task OnCrimeTypesChanged(IReadOnlyCollection<string> values)
    {
        selectedCrimeTypes = values.ToHashSet();
        await FilterCrimesAsync();
    }

    private List<CrimeDTO> crimeList = new();
    private List<CrimeDTO> filteredCrimeList = new();

    private bool _isLoading;
    private string errorMessage = string.Empty;

    private bool _hasSelectedFilters =>
        selectedCities.Any() || selectedCrimeTypes.Any();

    private async Task GetCrimesAsync()
    {
        try
        {
            _isLoading = true;
            errorMessage = string.Empty;

            var client = HttpClientFactory.CreateClient("PolisApi");

            var selectedCitiesQuery = string.Join(";", selectedCities);

            var apiUrl = $"/Stad?searchWord={selectedCitiesQuery}";

            var response = await client.GetAsync(apiUrl);
            response.EnsureSuccessStatusCode();

            var json = await response.Content.ReadAsStringAsync();

            crimeList =
                JsonConvert.DeserializeObject<List<CrimeDTO>>(json)
                ?? new();

            await FilterCrimesAsync();
        }
        catch (Exception ex)
        {
            crimeList.Clear();
            filteredCrimeList.Clear();
            errorMessage = $"Kunde inte hämta brott: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task FilterCrimesAsync()
    {
        if (!selectedCrimeTypes.Any())
        {
            await CrimeListChanged.InvokeAsync(crimeList);
            return;
        }

        filteredCrimeList = crimeList
            .Where(crime =>
                selectedCrimeTypes.Any(type =>
                    crime.Type.Contains(type, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        await CrimeListChanged.InvokeAsync(filteredCrimeList);
    }

    private async Task ClearSelections()
    {
        selectedCities.Clear();
        selectedCrimeTypes.Clear();

        crimeList.Clear();
        filteredCrimeList.Clear();

        errorMessage = string.Empty;

        await CrimeListChanged.InvokeAsync(new List<CrimeDTO>());
    }

